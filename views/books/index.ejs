<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Library Management System</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="logo">

            📚 Library Pro

        </div>


        <ul class="menu">

            <li>

                <a href="/books" class="active">

                    🏠 Dashboard

                </a>

            </li>


            <li>

                <a href="#">

                    👨‍🎓 Students

                </a>

            </li>


            <li>

                <a href="/books">

                    📚 Books Available

                </a>

            </li>


            <li>

                <a href="#">

                    📖 Issue / Return

                </a>

            </li>


            <li>

                <a href="#">

                    📊 Reports

                </a>

            </li>


            <li>

                <a href="#">

                    ⚙️ Settings

                </a>

            </li>

        </ul>


    </aside>



    <!-- ================= MAIN ================= -->

    <main class="main">


        <!-- TOP BAR -->

        <div class="topbar">


            <div class="search-box">

                🔍

                <input
                    type="text"
                    id="searchInput"
                    placeholder="Search books..."
                >

            </div>


            <div class="admin">

                👤

                <strong>Admin</strong>

            </div>


        </div>



        <!-- WELCOME -->

        <div class="welcome">

            <h1>
                Welcome to Library 👋
            </h1>

            <p>
                Manage your books and library records easily.
            </p>

        </div>



        <!-- ================= CARDS ================= -->

        <div class="cards">


            <!-- TOTAL BOOKS -->

            <div class="card">

                <div class="card-icon">

                    📚

                </div>

                <div>

                    <h3>
                        <%= books.length %>
                    </h3>

                    <p>
                        Total Books
                    </p>

                </div>

            </div>



            <!-- TOTAL COPIES -->

            <div class="card">

                <div class="card-icon">

                    📦

                </div>

                <div>

                    <h3>

                        <%= books.reduce((total, book) => {

                            return total + Number(book.quantity);

                        }, 0) %>

                    </h3>

                    <p>
                        Available Copies
                    </p>

                </div>

            </div>



            <!-- ISSUED -->

            <div class="card">

                <div class="card-icon">

                    📖

                </div>

                <div>

  <h3>
    <%= issuedBooks %>
</h3>

                    <p>
                        Books Issued
                    </p>

                </div>

            </div>



            <!-- STUDENTS -->

            <div class="card">

                <div class="card-icon">

                    👨‍🎓

                </div>

                <div>

  <h3>
    <%= students.length %>
</h3>
                    <p>
                        Total Students
                    </p>

                </div>

            </div>


        </div>



        <!-- ================= BOOK SECTION ================= -->

        <div class="section">


            <div class="section-header">


                <div>

                    <h2>
                        📚 Books Collection
                    </h2>

                    <p>
                        Manage all books in your library
                    </p>

                </div>


                <a
                    href="/books/add"
                    class="add-btn"
                >

                    + Add New Book

                </a>


            </div>



            <!-- TABLE -->

            <div class="table-container">


                <table id="bookTable">


                    <thead>

                        <tr>

                            <th>
                                Sr No.
                            </th>

                            <th>
                                Book Title
                            </th>

                            <th>
                                Author
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                ISBN
                            </th>

                            <th>
                                Quantity
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>



                    <tbody>


                        <% books.forEach((book, index) => { %>


                            <tr>


                                <td>

                                    <%= index + 1 %>

                                </td>


                                <td>

                                    <strong>

                                        <%= book.title %>

                                    </strong>

                                </td>


                                <td>

                                    <%= book.author %>

                                </td>


                                <td>

                                    <span class="category">

                                        <%= book.category %>

                                    </span>

                                </td>


                                <td>

                                    <%= book.isbn %>

                                </td>


                                <td>

                                    <span class="quantity">

                                        <%= book.quantity %>

                                    </span>

                                </td>


                                <td>


                                    <a
                                        href="/books/edit/<%= book._id %>"
                                        class="edit-btn"
                                    >

                                        Edit

                                    </a>



                                    <form
                                        action="/books/delete/<%= book._id %>"
                                        method="POST"
                                        class="delete-form"
                                    >

                                        <button
                                            type="submit"
                                            class="delete-btn"
                                        >

                                            Delete

                                        </button>

                                    </form>


                                </td>


                            </tr>


                        <% }) %>


                    </tbody>


                </table>


            </div>


        </div>


    </main>



    <!-- ================= SEARCH ================= -->

    <script>

        const searchInput = document.getElementById("searchInput");

        const table = document.getElementById("bookTable");

        const rows = table
            .getElementsByTagName("tbody")[0]
            .getElementsByTagName("tr");


        searchInput.addEventListener("keyup", function () {

            const searchValue =
                searchInput.value.toLowerCase();


            for (let i = 0; i < rows.length; i++) {

                const rowText =
                    rows[i].innerText.toLowerCase();


                if (rowText.includes(searchValue)) {

                    rows[i].style.display = "";

                } else {

                    rows[i].style.display = "none";

                }

            }

        });

    </script>


</body>

</html>