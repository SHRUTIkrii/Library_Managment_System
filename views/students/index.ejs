<h1>Students</h1>

<a href="#">Add Student</a>

<table border="1">

    <thead>

        <tr>
            <th>Sr No.</th>
            <th>Name</th>
            <th>Email</th>
            <th>Contact</th>
            <th>Course</th>
            <th>Action</th>
        </tr>

    </thead>

    <tbody>

        <% students.forEach((student, index) => { %>

            <tr>

                <td><%= index + 1 %></td>

                <td><%= student.name %></td>

                <td><%= student.email %></td>

                <td><%= student.contact %></td>

                <td><%= student.course %></td>
                <td>

    <a href="/students/edit/<%= student._id %>">
        Edit
    </a>

    <form
        action="/students/delete/<%= student._id %>"
        method="POST"
        style="display:inline;"
    >

        <button type="submit">
            Delete
        </button>

    </form>

</td>

            </tr>

        <% }) %>

    </tbody>

</table>